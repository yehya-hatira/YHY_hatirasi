/* pages/login/login.wxss */

/* ===== 根容器（保持不动） ===== */
.container {
  width: 100%;
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  
  /* CSS 变量定义 */
  --stop-position: 50%;
  --transition-width: 60%;
  
  /* 核心渐变：柔和过渡 */
  background: linear-gradient(
    180deg,
    #673ab7 0%,
    #673ab7 calc(var(--stop-position) - var(--transition-width) / 2),
    #9c27b0 calc(var(--stop-position) + var(--transition-width) / 2),
    #9c27b0 100%
  );
  
  transition: background 0.1s linear;
}

/* ===== 玻璃拟态卡片 ===== */
.glass-card {
  width: 520rpx;
  background: rgba(255, 255, 255, 0.08); /* 更透明，增强玻璃感 */
  border: 1px solid rgba(255, 255, 255, 0.15); /* 更细更淡的边框 */
  border-radius: 32rpx;
  padding: 138rpx 40rpx;
  box-sizing: border-box;
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  z-index: 10;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.1),
    inset 0 1px 1px rgba(255, 255, 255, 0.2); /* 保留关键内高光 */
}

/* ===== 卡片标题 ===== */
.card-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
  margin-bottom: 48rpx;
  letter-spacing: 2rpx;
}

/* ===== 输入框组 (通用容器) ===== */
.input-group {
  position: relative;
  width: 100%;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.06); /* 极淡背景，几乎透明 */
  border: 1px solid rgba(255, 255, 255, 0.12); /* 超细边框 */
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  
  display: flex;
  align-items: center;
  justify-content: space-between;
  
  transition: all 0.3s ease;
  overflow: hidden;
  
  /* 增加微妙的内阴影，增强立体感 */
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.05);
}

.input-group:focus-within {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.25);
  box-shadow: 
    0 0 16rpx rgba(255, 255, 255, 0.1),
    inset 0 1px 2px rgba(0, 0, 0, 0.05);
}

/* ===== 输入框本体 ===== */
.input-field {
  flex: 1;
  height: 100%;
  background: transparent;
  border: none;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #fff;
  line-height: 80rpx;
  outline: none;
}

.input-field::placeholder {
  color: rgba(255, 255, 255, 0.3);
  font-size: 26rpx;
}

/* ===== 验证码行 (合并版 - 高保真玻璃拟态) ===== */
.code-group {
  padding: 0;
  margin-bottom: 24rpx;
}

.code-input {
  /* 关键修改：设置最小宽度，确保“验证码”三字完整显示 */
  min-width: 180rpx; /* 根据实际字体大小调整，保证“验证码”不被截断 */
  padding-right: 8rpx; /* 与按钮之间留一点呼吸感 */
}

/* 【核心】内置获取验证码按钮 - 无界融合 */
.btn-get-code {
  flex-shrink: 0;
  width: auto;
  height: 100%;
  
  /* 完全透明，无任何边框或背景 */
  background: transparent;
  border: none;
  
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85); /* 稍亮一点，突出可点击性 */
  font-weight: 500;
  
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx; /* 左右内边距，让文字不贴边 */
  margin: 0;
  line-height: normal;
  transition: all 0.3s ease;
  
  /* 可选：添加极细微的左侧分隔线，仅在高对比度下可见 */
  /* border-left: 0.5px solid rgba(255, 255, 255, 0.08); */
}

.btn-get-code::after {
  border: none;
}

.btn-get-code:active:not(.btn-disabled) {
  color: #fff;
  background: rgba(255, 255, 255, 0.05); /* 轻微高亮，不破坏整体 */
}

.btn-disabled {
  opacity: 0.4;
  color: rgba(255, 255, 255, 0.3);
}

/* ===== 一键登录按钮 ===== */
.btn-login {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.08));
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 4rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.btn-login::after {
  border: none;
}

.btn-login:active {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.12));
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.2);
  transform: scale(0.98);
}