/*礼物动画*/
.gift-animation {
  position: absolute;
  width: 50px;
  height: 50px;
  animation: float 5s linear;
}
/** 礼物向上漂浮动画 */ 
@keyframes float {
  0% { transform: translateY(130px); }/*初始状态不改变位置*/
  100% { transform: translateY(-10px); }/*向上漂浮200px*/
}
/** 礼物排型列 */
.gift-column {
  display: flex;
  flex-direction: column;
  justify-content: space-around;
}

/* 礼物滚动区域 */
.gift-scroll {
  height: 360px; /* 与礼物区域高度一致 */
  overflow-y: scroll;
  scroll-snap-type: y mandatory; /* 启用垂直滚动吸附 */
}

/* 礼物项样式 */
