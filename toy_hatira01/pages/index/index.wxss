/* 添加弹出和缩回的动画样式 */
.my-Msg-circle, .my-userBalance-circle, .my-Setup-circle {
  position: absolute;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-image: radial-gradient(circle, #ffffff, #9e0fe0d3);
  border: 2px solid #AC33C1;
  z-index: 4;
  opacity: 0; /* 初始状态为隐藏 */
  transform: scale(0) translate(-20px, -100px); /* 初始状态为缩放为0，位置为中心 */
  transition: opacity 0.3s ease, transform 0.3s ease;
}

/* 弹出动画 */
.my-Msg-circle.show {
  opacity: 1; /* 结束状态为显示 */
  transform: scale(1) translate(-60px, 20px); /* 45° 角位移 */
}

.my-userBalance-circle.show {
  opacity: 1; /* 结束状态为显示 */
  transform: scale(1) translate(-7px, 45px); /* 竖直向下位移 */
}

.my-Setup-circle.show {
  opacity: 1; /* 结束状态为显示 */
  transform: scale(1) translate(45px, 20px); /* 135° 角位移 */
}

/* 缩回动画 */
.my-Msg-circle.hide, .my-userBalance-circle.hide, .my-Setup-circle.hide {
  opacity: 0; /* 结束状态为隐藏 */
  transform: scale(0) translate(-30px, -100px); /* 结束状态为缩放为0，回到中心 */
  transition: opacity 0.3s ease, transform 0.3s ease;
}

