<!-- pages/login/login.wxml -->
<view class="container" style="{{containerStyle}}">

  <!-- 玻璃拟态卡片 -->
  <view class="glass-card">
    
    <!-- 标题 -->
    <text class="card-title">开启瞎记</text>
    
    <!-- 手机号输入 -->
    <!-- 结构保持不变：input 直接在 input-group 内 -->
    <view class="input-group">
      <input
        class="input-field"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <!-- 验证码输入 + 获取按钮 (已合并) -->
    <!-- 修改点 1: 将 class="code-row" 改为 class="input-group code-group" -->
    <!-- 修改点 2: 确保 input 和 button 是直接子元素 -->
    <view class="input-group code-group">
      <input
        class="input-field code-input"
        type="number"
        maxlength="6"
        placeholder="验证码"
        value="{{code}}"
        bindinput="onCodeInput"
      />
      <button
        class="btn-get-code {{countdown > 0 ? 'btn-disabled' : ''}}"
        bindtap="onSendCode"
        disabled="{{countdown > 0 || isSendingCode}}"
      >
        <text wx:if="{{countdown > 0}}">{{countdown}}s</text>
        <text wx:else>获取验证码</text>
      </button>
    </view>

    <!-- 一键登录按钮（微信授权） -->
    <button
      class="btn-login"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
    >
      一键登录
    </button>

  </view>

</view>