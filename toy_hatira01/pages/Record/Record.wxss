 .func-icon {
   width: 24px;
   height: 24px;
 }
 
 .func-keys {
   transition: opacity 1s ease, transform 1s ease;
   opacity: 1;
   transform: translateY(20);
 }
 
 .func-keys.hide {
   opacity: 0;
   transform: translateY(-20px);
 }
 
 /* 添加动画效果 */
 .dele-key-circle, .b0-key-circle, .b1-key-circle, .add-key-circle {
   transition: opacity 0.3s ease, transform 0.3s ease;
   opacity: 0; /* 初始状态 */
   transform: translateX(20px); /* 初始状态，向右偏移 */
 }
 
 .dele-key-circle.show, .b0-key-circle.show, .b1-key-circle.show, .add-key-circle.show {
   opacity: 1; /* 结束状态 */
   transform: translateX(0); /* 结束状态，回到原位 */
 }
 
