page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden; /* 禁用页面滚动 */
}

.container {
  flex: 1;
  padding: 40rpx 30rpx 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden; /* 禁用容器滚动 */
  
  /* CSS 变量定义 */
  --stop-position: 50%;
  --transition-width: 60%;
  
  /* 核心渐变：柔和过渡 */
  background: linear-gradient(
    180deg,
    #673ab7 0%,
    #673ab7 calc(var(--stop-position) - var(--transition-width) / 2),
    #9c27b0 calc(var(--stop-position) + var(--transition-width) / 2),
    #9c27b0 100%
  );
  
  transition: background 0.1s linear;
}

.msg-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
  position: relative;
  z-index: 10; /* 确保标题在最上层 */
  background: linear-gradient(180deg, #673ab7, rgba(103, 58, 183, 0.95));
  padding-bottom: 20rpx;
}

.msg-title {
  font-size: 34rpx;
  color: #ffffff;
  font-weight: 500;
}

.msg-badge {
  min-width: 40rpx;
  padding: 4rpx 12rpx;
  background-color: #ff5252;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 22rpx;
  text-align: center;
}

/* 滚动容器 */
.notifications-scroll {
  flex: 1;
  width: 100%;
  height: 100%;
  overflow-y: scroll;
}

/* 隐藏滚动条 */
.notifications-scroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

.notifications {
  display: flex;
  flex-direction: column-reverse;
  padding-bottom: 20rpx;
}

.notification-item {
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.notification-text {
  font-size: 28rpx;
  color: #000000;
  margin-top: 10rpx;
}

.timestamp {
  font-size: 28rpx;
  color: #000000;
}

.empty-state {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color:rgb(245, 245, 245);
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.empty-subtitle {
  font-size: 24rpx;
  opacity: 0.85;
}