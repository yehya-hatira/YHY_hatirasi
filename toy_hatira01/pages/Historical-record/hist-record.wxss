/* pages/Historical-record/hist-record.wxss */
.page {
  /*height: 100vh;
   display: flex;
   flex-direction: column;*/
   width: 100%;
   height: 100%;
   margin: 0;
   padding: 0;
   background: #f0f0f0;
 }
 
 .scrollarea {
   flex: 1;
   overflow-y: auto;
   height: 100vh;
 }
 
 .container {
   width: 100%;
   height: 100vh;
   position: relative;
   background: linear-gradient(180deg, #673ab7, #9c27b0);
}

.empty-state {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #f5f5f5;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.empty-subtitle {
  font-size: 24rpx;
  opacity: 0.85;
}