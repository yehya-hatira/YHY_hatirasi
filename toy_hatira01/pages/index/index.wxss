/* 如果需要，可以在这里添加弹出和收回的动画样式 */

.a-left-gift-area,.a-right-gift-area,.b-left-gift-area, .b-right-gift-area,.b-l-send-rectangle,.b-r-send-rectangle {
  transition: transform 0.5s ease; /* 动画过渡效果，增加到0.5s */
}

.slide-in {
  transform: translateX(0); /* 从原位置显示 */
}

.slide-out {
  transform: translateX(-100%); /* 向左缩回 */
}

.a-right-gift-area.slide-out,
.b-right-gift-area.slide-out,
.b-r-send-rectangle.slide-out {
  transform: translateX(100%); /* 向右缩回 */
}

/* 确保 slide-in 动画的持续时间与 slide-out 一致 */
.a-left-gift-area.slide-in,
.a-right-gift-area.slide-in,
.b-left-gift-area.slide-in,
.b-right-gift-area.slide-in,
.b-l-send-rectangle.slide-in,
.b-r-send-rectangle.slide-in {
  transition: transform 0.5s ease; /* 动画过渡效果，增加到0.5s */
}

.a-left-gift-area,.a-right-gift-area,.b-left-gift-area, .b-right-gift-area,.b-l-send-rectangle,.b-r-send-rectangle {
  transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1); /* 更流畅的贝塞尔曲线 */
  will-change: transform; /* 启用硬件加速 */
}


