/* pages/touxiang/touxiang.wxss */
.container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  
  /* CSS 变量定义 */
  --stop-position: 50%;
  --transition-width: 60%;
  
  /* 核心渐变：柔和过渡 */
  background: linear-gradient(
    180deg,
    #673ab7 0%,
    #673ab7 calc(var(--stop-position) - var(--transition-width) / 2),
    #9c27b0 calc(var(--stop-position) + var(--transition-width) / 2),
    #9c27b0 100%
  );
  
  transition: background 0.1s linear;
}

.large-avatar {
  width: 80%;
  height: 80vw; /* 保持正方形 */
  border-radius: 50%;
  transition: transform 0.3s ease;
  box-shadow: 0 8rpx 25rpx rgba(0,0,0,0.2);
}

.large-avatar:active {
  transform: scale(0.95);
}

.three-dots {
  position: absolute;
  right: 30rpx;
  top: 30rpx;
  font-size: 30px; /* 调整字体大小 */
  color: white; /* 设置颜色 */
}