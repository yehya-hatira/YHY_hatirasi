/* pages/Historical-record/hist-record.wxss */
.page {
  /*height: 100vh;
   display: flex;
   flex-direction: column;*/
   width: 100%;
   height: 100%;
   margin: 0;
   padding: 0;
   background: #f0f0f0;
 }
 
 .scrollarea {
   flex: 1;
   overflow-y: auto;
   height: 100vh;
 }
 
 .container {
   width: 100%;
   height: 100vh;
   position: relative;
   display: flex;
   flex-direction: column;
   align-items: center;
   justify-content: center;
   overflow: hidden;
   
   /* CSS 变量定义 */
   --stop-position: 50%;
   --transition-width: 60%;
   
   /* 核心渐变：柔和过渡 */
   background: linear-gradient(
     180deg,
     #673ab7 0%,
     #673ab7 calc(var(--stop-position) - var(--transition-width) / 2),
     #9c27b0 calc(var(--stop-position) + var(--transition-width) / 2),
     #9c27b0 100%
   );
   
   transition: background 0.1s linear;
}

.empty-state {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #f5f5f5;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.empty-subtitle {
  font-size: 24rpx;
  opacity: 0.85;
}

.records-list {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  overflow-y: auto;
}

.record-item {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.record-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record-desc {
  font-size: 26rpx;
  color: #fff;
  margin-bottom: 6rpx;
}

.record-time {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}